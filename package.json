{
  "name": "@algoryq/one-website",
  "version": "0.1.0",
  "private": true,
  "description": "Algoryq One enterprise product website — an Algoryq Technologies product. Light mode only.",
  "scripts": {
    "dev": "next dev -p 3500",
    "build": "next build",
    "start": "next start -p 3500",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "next lint",
    "check:links": "node scripts/check-links.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "audit": "node scripts/audit.mjs",
    "audit:quick": "node scripts/audit.mjs --quick",
    "audit:shots": "node scripts/audit.mjs --shots",
    "verify": "npm run typecheck && npm run check:contrast && npm run build"
  },
  "dependencies": {
    "framer-motion": "^13.0.0",
    "lucide-react": "^0.474.0",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.1",
    "@types/node": "^22.10.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "axe-core": "^4.12.1",
    "playwright": "^1.62.1",
    "tailwindcss": "4.3.1",
    "typescript": "~5.9.0"
  }
}
